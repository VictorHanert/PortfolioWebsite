# Gmail credentials for contact form
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password

# MapTiler API key
VITE_MAPTILER_API_KEY=your-maptiler-api-key

# Gemini API key for AI chatbot
GEMINI_API_KEY=your-gemini-api-key

# AI Gateway Vercel
AI_GATEWAY_API=your-ai-gateway-api-key

# Supabase
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase, used locally by scripts/seed-destinations.mjs. Never prefix with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Offline development only: return fake embeddings from /api/embed (ignored in production)
EMBED_MOCK=false
