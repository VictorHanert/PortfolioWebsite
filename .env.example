# Gmail credentials for contact form
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password

# MapTiler API key
VITE_MAPTILER_API_KEY=your-maptiler-api-key

# Gemini API key for AI chatbot
GEMINI_API_KEY=your-gemini-api-key

# AI Gateway Vercel
AI_GATEWAY_API=your-ai-gateway-api-key

# Supabase, read by /api/travel-agent (server only, set by the Vercel Supabase integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server only: the seed script and the Top destinations counters (api/_lib/stats.ts).
# Never prefix with VITE_ and never add to client code.
SUPABASE_SERVICE_ROLE_KEY=

# Local scripts only
UNSPLASH_ACCESS_KEY=
